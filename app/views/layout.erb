<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClimaBom | Previsão do Tempo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-500 to-blue-700 min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-white text-4xl font-bold tracking-tight">Clima<span class="font-light text-blue-100">Bom</span></h1>
            <p class="text-blue-100 opacity-80">Sua previsão em tempo real</p>
        </div>

        <div class="relative mb-6 group">
            <input type="text" id="cityInput" placeholder="Busque uma cidade..." 
                class="w-full p-4 pl-12 rounded-2xl bg-white/90 border-none shadow-xl focus:ring-2 focus:ring-blue-300 transition-all outline-none text-gray-700 placeholder-gray-400">
            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-blue-500 transition-colors"></i>
            <button id="searchBtn" class="absolute right-2 top-1/2 -translate-y-1/2 bg-blue-600 text-white px-4 py-2 rounded-xl hover:bg-blue-700 transition-all active:scale-95">
                Buscar
            </button>
        </div>

        <div id="weatherCard" class="glass rounded-3xl p-8 text-white text-center shadow-2xl hidden transition-all duration-500">
            <div class="mb-4">
                <h2 id="cityName" class="text-3xl font-bold">São Paulo</h2>
                <p id="date" class="text-blue-100 text-sm opacity-80">Segunda-feira, 12 de Outubro</p>
            </div>

            <div class="flex flex-col items-center my-6">
                <i id="weatherIcon" class="fas fa-cloud-sun text-7xl mb-4 drop-shadow-lg"></i>
                <div class="flex items-start">
                    <span id="temp" class="text-7xl font-bold">24</span>
                    <span class="text-3xl font-semibold mt-2">°C</span>
                </div>
                <p id="description" class="capitalize text-lg font-medium mt-2">Céu Limpo</p>
            </div>

            <div class="grid grid-cols-2 gap-4 mt-8 border-t border-white/20 pt-6">
                <div class="flex items-center gap-3 justify-center">
                    <i class="fas fa-droplet text-blue-200"></i>
                    <div class="text-left">
                        <p class="text-xs opacity-70">Umidade</p>
                        <p id="humidity" class="font-bold">65%</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 justify-center">
                    <i class="fas fa-wind text-blue-200"></i>
                    <div class="text-left">
                        <p class="text-xs opacity-70">Vento</p>
                        <p id="wind" class="font-bold">12 km/h</p>
                    </div>
                </div>
            </div>
        </div>

        <div id="placeholder" class="glass rounded-3xl p-12 text-center text-white/60 italic border-dashed border-2">
            Digite o nome de uma cidade para ver o clima.
        </div>
    </div>

    <script>
        // Nota: Para funcionar de verdade, você precisará de uma API Key da OpenWeatherMap
        const apiKey = "https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}&lang=pt_br"; 
        
        const searchBtn = document.getElementById('searchBtn');
        const cityInput = document.getElementById('cityInput');
        const weatherCard = document.getElementById('weatherCard');
        const placeholder = document.getElementById('placeholder');

        async function checkWeather(city) {
            // Simulando a chamada da API para demonstração visual
            // Em produção, use: `https://api.openweathermap.org/data/2.5/weather?q=${city}&units=metric&appid=${apiKey}&lang=pt_br`
            
            if(city.trim() === "") return;

            // Mostrando o card com animação simples
            placeholder.classList.add('hidden');
            weatherCard.classList.remove('hidden');
            
            // Aqui você faria o fetch e preencheria os campos:
            // document.getElementById('cityName').innerText = data.name;
            // ... etc
        }

        searchBtn.addEventListener('click', () => checkWeather(cityInput.value));
        cityInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') checkWeather(cityInput.value);
        });
    </script>
</body>
</html>